# Copia este archivo como .env.local y completa solo lo que necesites.
# La URL y los datos de contacto ya tienen valores por defecto en src/config/site.ts;
# define estas variables únicamente para sobrescribirlos.

# URL pública del sitio (sin barra final). Se usa para SEO, sitemap y Open Graph.
NEXT_PUBLIC_SITE_URL=

# --- Contacto (sobrescriben los valores por defecto) ---
# Número de WhatsApp en formato internacional, solo dígitos. Ej: 5939XXXXXXXX
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_ADDRESS=

# --- Redes sociales (URL completa) ---
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_TIKTOK=
NEXT_PUBLIC_SOCIAL_LINKEDIN=

# --- Formulario de contacto (privadas, solo servidor) ---
# Opción A: correo con Resend (https://resend.com)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Remitente con dominio verificado en Resend. Ej: Macross AI <web@tu-dominio.com>
CONTACT_FROM_EMAIL=
# Opción B: webhook (Make, Zapier, n8n, Google Apps Script...). Se usa si no hay Resend.
CONTACT_WEBHOOK_URL=

# --- Analítica (opcional) ---
# ID de Google Analytics 4. Ej: G-XXXXXXXXXX. Solo se carga si el visitante acepta las cookies.
NEXT_PUBLIC_GA_ID=
